<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SoundPlayerChiyomaru"
        x:Class="SoundPlayerChiyomaru.SettingsWindow"
        Title="{x:Static local:Strings.SettingsTitle}"
        Width="680"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        ShowInTaskbar="False"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner">
    <!--
      変更はその場で反映して保存する（「OK」「キャンセル」は置かない）。
      各部品の状態は、コードで設定から読み、操作されたら設定へ書く（SettingsWindow.axaml.cs）。メニューなど他の場所から
      同じ設定が変えられたときに、ここの表示を合わせ直すため。
    -->
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style Selector="TextBlock.first">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinWidth" Value="260" />
        </Style>
        <Style Selector="ListBox#PageList ListBoxItem">
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="170,*">
        <!-- 選択を外せると、どのページも出ていない状態になる。 -->
        <ListBox x:Name="PageList" Padding="0,12,0,0" SelectionMode="AlwaysSelected" SelectionChanged="OnPageChanged">
            <ListBoxItem Content="{x:Static local:Strings.PageOutput}" />
            <ListBoxItem Content="{x:Static local:Strings.PagePlaylist}" />
            <ListBoxItem Content="{x:Static local:Strings.PageStartup}" />
            <ListBoxItem Content="{x:Static local:Strings.PageDisplay}" />
            <ListBoxItem Content="{x:Static local:Strings.PageAbout}" />
        </ListBox>

        <ScrollViewer Grid.Column="1">
            <Panel x:Name="Pages" Margin="20,16,20,20">
                <StackPanel>
                    <TextBlock Classes="section first" Text="{x:Static local:Strings.OutputDevice}" />
                    <ComboBox x:Name="DeviceBox" SelectionChanged="OnDeviceChanged" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.OutputMode}" />
                    <RadioButton x:Name="SharedRadio" GroupName="OutputMode" Content="{x:Static local:Strings.SharedMode}" IsCheckedChanged="OnOutputModeChanged" />
                    <RadioButton x:Name="ExclusiveRadio" GroupName="OutputMode" Content="{x:Static local:Strings.ExclusiveMode}" IsCheckedChanged="OnOutputModeChanged" />
                    <TextBlock Classes="note" Text="{x:Static local:Strings.ExclusiveModeNote}" />

                    <TextBlock Classes="section" Text="ReplayGain" />
                    <ComboBox x:Name="ReplayGainBox" SelectionChanged="OnReplayGainChanged">
                        <ComboBoxItem Content="{x:Static local:Strings.ReplayGainOff}" />
                        <ComboBoxItem Content="{x:Static local:Strings.ReplayGainTrack}" />
                        <ComboBoxItem Content="{x:Static local:Strings.ReplayGainAlbum}" />
                    </ComboBox>
                    <TextBlock Classes="note" Text="{x:Static local:Strings.ReplayGainNote}" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.BufferLength}" />
                    <ComboBox x:Name="BufferBox" SelectionChanged="OnBufferChanged" />
                    <TextBlock Classes="note" Text="{x:Static local:Strings.BufferNote}" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.BitDepth}" />
                    <ComboBox x:Name="BitDepthBox" SelectionChanged="OnBitDepthChanged" />
                    <TextBlock Classes="note" Text="{x:Static local:Strings.BitDepthNote}" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.CurrentOutput}" />
                    <TextBlock x:Name="OutputStatusText" Classes="note" />
                </StackPanel>

                <StackPanel IsVisible="False">
                    <TextBlock Classes="section first" Text="{x:Static local:Strings.AddingTracks}" />
                    <CheckBox x:Name="ExcludeDuplicatesBox" Content="{x:Static local:Strings.ExcludeDuplicates}" IsCheckedChanged="OnExcludeDuplicatesChanged" />
                    <TextBlock Classes="note" Text="{x:Static local:Strings.ExcludeDuplicatesNote}" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.VisibleColumns}" />
                    <!-- Tag は PlaylistColumn の名前。タイトルの列は常に表示するので、ここには出さない。 -->
                    <WrapPanel x:Name="ColumnBoxes">
                        <CheckBox Content="{x:Static local:Strings.ColumnOrder}" Tag="Order" Margin="0,0,18,0" IsCheckedChanged="OnColumnChanged" />
                        <CheckBox Content="{x:Static local:Strings.ColumnTrackNumber}" Tag="TrackNumber" Margin="0,0,18,0" IsCheckedChanged="OnColumnChanged" />
                        <CheckBox Content="{x:Static local:Strings.ColumnArtist}" Tag="Artist" Margin="0,0,18,0" IsCheckedChanged="OnColumnChanged" />
                        <CheckBox Content="{x:Static local:Strings.ColumnAlbum}" Tag="Album" Margin="0,0,18,0" IsCheckedChanged="OnColumnChanged" />
                        <CheckBox Content="{x:Static local:Strings.ColumnAlbumArtist}" Tag="AlbumArtist" Margin="0,0,18,0" IsCheckedChanged="OnColumnChanged" />
                        <CheckBox Content="{x:Static local:Strings.ColumnDuration}" Tag="Duration" Margin="0,0,18,0" IsCheckedChanged="OnColumnChanged" />
                        <CheckBox Content="{x:Static local:Strings.ColumnFileName}" Tag="FileName" Margin="0,0,18,0" IsCheckedChanged="OnColumnChanged" />
                    </WrapPanel>
                    <Button Content="{x:Static local:Strings.ResetColumns}" Margin="0,8,0,0" Click="OnResetColumnsClick" />
                    <TextBlock Classes="note" Text="{x:Static local:Strings.ColumnsNote}" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.SavingPlaylists}" />
                    <CheckBox x:Name="RelativePathsBox" Content="{x:Static local:Strings.RelativePaths}" IsCheckedChanged="OnRelativePathsChanged" />
                    <TextBlock Classes="note" Text="{x:Static local:Strings.RelativePathsNote}" />
                </StackPanel>

                <StackPanel IsVisible="False">
                    <TextBlock Classes="section first" Text="{x:Static local:Strings.ExternalOpen}" />
                    <!-- Tag は ExternalOpenAction の値。 -->
                    <StackPanel x:Name="ExternalOpenRadios">
                        <RadioButton GroupName="ExternalOpen" Tag="0" Content="{x:Static local:Strings.ExternalReplace}" IsCheckedChanged="OnExternalOpenChanged" />
                        <RadioButton GroupName="ExternalOpen" Tag="1" Content="{x:Static local:Strings.ExternalAppend}" IsCheckedChanged="OnExternalOpenChanged" />
                        <RadioButton GroupName="ExternalOpen" Tag="2" Content="{x:Static local:Strings.ExternalAppendAndPlay}" IsCheckedChanged="OnExternalOpenChanged" />
                    </StackPanel>
                    <TextBlock Classes="note" Text="{x:Static local:Strings.ExternalOpenNote}" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.FileAssociations}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static local:Strings.Register}" Click="OnRegisterAssociationClick" />
                        <Button Content="{x:Static local:Strings.Unregister}" Click="OnUnregisterAssociationClick" />
                    </StackPanel>
                    <TextBlock Classes="note" Text="{x:Static local:Strings.AssociationsNote}" />
                    <!-- 登録・解除の結果。上の説明と区別できるよう、間を空けて普通の文字で出す。 -->
                    <TextBlock x:Name="AssociationStatusText" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel IsVisible="False">
                    <!--
                      見出しは両方の言語で書く。読めない言語に切り替えてしまっても、戻す場所を見つけられるように。
                      並びは AppLanguage の値の順。言語の名前は、その言語で書く。
                    -->
                    <TextBlock Classes="section first" Text="{x:Static local:Strings.Language}" />
                    <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="{x:Static local:Strings.LanguageSystem}" />
                        <ComboBoxItem Content="日本語" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                    <!-- 選んだ言語が今の画面の言語と違うときだけ出す（SettingsWindow.UpdateLanguageNotice）。 -->
                    <StackPanel x:Name="LanguageRestartPanel" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" IsVisible="False">
                        <TextBlock Text="{x:Static local:Strings.LanguageRestartNote}" VerticalAlignment="Center" />
                        <Button x:Name="RestartButton" Content="{x:Static local:Strings.RestartNow}" Click="OnRestartClick" />
                    </StackPanel>
                    <!-- 再起動の前に設定を保存できなかったときの理由。 -->
                    <TextBlock x:Name="RestartErrorText" Classes="note" IsVisible="False" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.Theme}" />
                    <!-- 並びは AppTheme の値の順。 -->
                    <ComboBox x:Name="ThemeBox" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="{x:Static local:Strings.ThemeChiyomaruSystem}" />
                        <ComboBoxItem Content="Chiyomaru: Light" />
                        <ComboBoxItem Content="Chiyomaru: Dark" />
                        <ComboBoxItem Content="Windows: System" />
                        <ComboBoxItem Content="Windows: Light" />
                        <ComboBoxItem Content="Windows: Dark" />
                    </ComboBox>
                    <TextBlock Classes="note" Text="{x:Static local:Strings.ThemeNote}" />

                    <TextBlock Classes="section" Text="{x:Static local:Strings.Window}" />
                    <CheckBox x:Name="AlwaysOnTopBox" Content="{x:Static local:Strings.AlwaysOnTopSetting}" IsCheckedChanged="OnAlwaysOnTopChanged" />
                </StackPanel>

                <DockPanel IsVisible="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16">
                        <Image x:Name="AboutImage" Width="96" Height="96" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Sound Player Chiyomaru" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" />
                            <TextBlock Text="{x:Static local:Strings.Author}" />
                            <TextBlock Text="{x:Static local:Strings.LicenseLine}" />
                        </StackPanel>
                    </StackPanel>
                    <ComboBox x:Name="DocumentBox" DockPanel.Dock="Top" Margin="0,16,0,8" SelectionChanged="OnDocumentChanged">
                        <ComboBoxItem Content="{x:Static local:Strings.ReleaseNotes}" />
                        <ComboBoxItem Content="{x:Static local:Strings.AppLicense}" />
                        <ComboBoxItem Content="{x:Static local:Strings.ThirdPartyLicenses}" />
                    </ComboBox>
                    <!--
                      文書は 1 行ずつの一覧にして、見えている行だけを組む。依存ライブラリのライセンス文は 15 万文字あり、
                      1 つのテキスト欄に入れると、表示するだけで約 18MB のメモリを使った。
                    -->
                    <ListBox x:Name="DocumentList" MinHeight="240" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,1" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" MinHeight="16" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</Window>
